{
  "name": "4qian",
  "productName": "4QIAN",
  "version": "4.0.0",
  "description": "4,228 bilingual conversation questions with a dashboard that tracks every one you ask.",
  "main": "main.js",
  "author": "4QIAN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fourqian.app",
    "productName": "4QIAN",
    "directories": {
      "output": "../release/windows",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "compression": "maximum",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "4QIAN",
      "artifactName": "4QIAN-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "4QIAN-portable-${version}.${ext}"
    }
  }
}
